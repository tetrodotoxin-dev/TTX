module(
    name = "ttx",
    version = "0.6.1",
)

bazel_dep(name = "rules_cc", version = "0.2.17")
bazel_dep(name = "platforms", version = "1.0.0")
bazel_dep(name = "rules_pkg", version = "1.3.0")
bazel_dep(name = "tetro_toolchain", version = "0.7.2")
archive_override(
    module_name = "tetro_toolchain",
    sha256 = "eccfd9b2d0f73310be82fdd2d10e51e0e42b410a6390ce8ec663d6cdff45a2e1",
    urls = ["https://github.com/tetrodotoxin-dev/Toolchain/releases/download/v0.7.2/tetro_toolchain-0.7.2-source.tar.gz"],
)

register_toolchains(
    "@tetro_toolchain//:cc_toolchain_for_linux_x86_64",
    "@tetro_toolchain//:cc_toolchain_for_wasm32",
    "@tetro_toolchain//:cc_toolchain_for_wasm32_runner",
    "@tetro_toolchain//:cc_toolchain_for_windows_x64",
)

sdks = use_extension("@tetro_toolchain//source/bazel:sdk.bzl", "dependencies")

_PERIMORTEM_ARCHIVES = {
    "headers": "ba2c0e7c54434f240a8578ed751562c6bd4ec8edd062bf279b58ee3ad3fba1b6",
    "linux-x86_64-v3-static": "4bace224a9f8adc100cb3ba43555bacdecb1f3419ca27a91aac5d6334969cacf",
    "linux-x86_64-v3-shared": "7af3560ca025cb5eb8fd0a931f42f84053eb7db858760aa313932d4e678c1f5e",
    "windows-x86_64-msvc-static": "7a1be911ab2e44835fab3663e1bfc6a817639040e8673dd3833e339e1ef0931f",
    "windows-x86_64-msvc-shared": "2bccfd6a8e993487dbbed4ff5a36a3cb5b6781ba4c56340495fd1b2435a9b683",
    "wasm32-emscripten-static": "2773128eca39e404fde217deff0b748ea7e3d6d648f6fd43a754635561c95afb",
    "wasm32-emscripten-shared": "5cf47781c85b4f06e68028496e5fd3beea7b529c369de00cc8d35374c20d7d02",
}

sdks.release(
    name = "perimortem",
    archives = _PERIMORTEM_ARCHIVES,
    linkage = "shared",
    project = "Perimortem",
    version = "0.6.0",
    deps = [],
)
sdks.release(
    name = "perimortem_static",
    archives = _PERIMORTEM_ARCHIVES,
    library = "perimortem",
    linkage = "static",
    project = "Perimortem",
    version = "0.6.0",
    deps = [],
)
use_repo(sdks, "perimortem", "perimortem_static")
